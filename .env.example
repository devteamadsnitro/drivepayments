# Servidor
NODE_ENV=production
PORT=3000

# Base de datos MySQL 8
DATABASE_URL=mysql://usuario:clave@127.0.0.1:3306/drivepayments

# Secreto de sesión (cadena larga y aleatoria). También deriva la clave de las notas del CRM.
MANUS_JWT_SECRET=cambia-esto-por-64-bytes-aleatorios

# Login del CRM (Manus OAuth). La web pública no lo necesita.
MANUS_PROJECT_ID=
MANUS_OAUTH_PORTAL_URL=https://manus.ai
MANUS_OAUTH_API_URL=https://api.manus.ai

# Object storage S3-compatible (Railway Bucket). En Railway se rellenan con
# referencias: S3_BUCKET=${{documents.BUCKET}}, S3_ENDPOINT=${{documents.ENDPOINT}}, etc.
S3_BUCKET=
S3_ENDPOINT=https://t3.storageapi.dev
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Solo para proveedores que exijan URLs path-style (p. ej. MinIO local)
S3_FORCE_PATH_STYLE=false

# Opcional: openId del propietario
OWNER_OPEN_ID=
