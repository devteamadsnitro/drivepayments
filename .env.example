# Servidor
NODE_ENV=production
PORT=3000

# Base de datos MySQL 8
DATABASE_URL=mysql://usuario:clave@127.0.0.1:3306/drivepayments

# Secreto de sesión (cadena larga y aleatoria). También deriva la clave de las notas del CRM.
MANUS_JWT_SECRET=cambia-esto-por-64-bytes-aleatorios

# Login del CRM (Manus OAuth). La web pública no lo necesita.
MANUS_PROJECT_ID=
MANUS_OAUTH_PORTAL_URL=https://manus.ai
MANUS_OAUTH_API_URL=https://api.manus.ai

# Object storage (endpoint y credencial)
MANUS_API_URL=
MANUS_API_KEY=

# Opcional: openId del propietario
OWNER_OPEN_ID=
