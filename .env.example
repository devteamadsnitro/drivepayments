# Servidor
NODE_ENV=production
PORT=3000

# Base de datos MySQL 8
DATABASE_URL=mysql://usuario:clave@127.0.0.1:3306/drivepayments

# Secreto de sesión del CRM (32+ caracteres aleatorios). También deriva la clave de las
# notas internas: no lo cambies una vez en producción.
SESSION_SECRET=cambia-esto-por-una-cadena-aleatoria-larga

# Código para crear el primer administrador del CRM en /admin (solo se usa una vez).
CRM_SETUP_TOKEN=

# Object storage S3-compatible (Railway Bucket). En Railway se rellenan con
# referencias: S3_BUCKET=${{documents.BUCKET}}, S3_ENDPOINT=${{documents.ENDPOINT}}, etc.
S3_BUCKET=
S3_ENDPOINT=https://t3.storageapi.dev
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Solo para proveedores que exijan URLs path-style (p. ej. MinIO local)
S3_FORCE_PATH_STYLE=false

